    "@cloudflare/workers-types": "^4.20250401.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "latest",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
